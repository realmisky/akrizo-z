# ── Required ──────────────────────────────────────────────────────────────────
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repo-name
# Fine-grained PAT with: Issues: Read & Write on the target repo only.
GITHUB_TOKEN=ghp_xxx

# ── LLM (pick one) ────────────────────────────────────────────────────────────
# Provider: "anthropic" or "ollama"
LLM_PROVIDER=anthropic

# If anthropic:
ANTHROPIC_API_KEY=sk-ant-xxx
LLM_MODEL=claude-sonnet-4-20250514

# If ollama (local, no API key needed):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Behavior (optional) ───────────────────────────────────────────────────────
# Dry-run is ON unless you explicitly set DRY_RUN=false.
DRY_RUN=true

# Issues carrying this label are triage candidates.
TRIAGE_LABEL=needs-triage
# Label the agent adds to an issue after it triages it.
APPLIED_MARKER=triaged-by-agent
# Comma-separated allowlist. The agent WILL NOT apply anything outside this list.
ALLOWED_LABELS=bug,enhancement,question,documentation,good-first-issue,needs-info

POLL_INTERVAL_MS=60000
MAX_ISSUES_PER_CYCLE=5
