# NullFee CLI credentials — TESTNET ONLY
# Copy this to the repo root as `.env` and fill in your NullFee login.

# Your NullFee username (e.g. "realmisky"). Aliases also work:
#   NULLFEE_LOGIN=…   or   NULLFEE_EMAIL=…
NULLFEE_USERNAME=your_username_here

NULLFEE_PASSWORD=your_password_here

# Optional overrides
# NULLFEE_CONFIG_PATH=/abs/path/to/nullfee.config.json
# NULLFEE_STATE_DIR=/abs/path/to/.nullfee-state
